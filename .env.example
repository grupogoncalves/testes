# Copie este arquivo para .env e preencha com seus dados
PORT=3000

# Use sandbox para testar. Troque para production quando estiver validado.
ASAAS_ENV=sandbox
ASAAS_API_KEY=$aact_hmlg_SUA_CHAVE_AQUI
ASAAS_BILLING_TYPE=UNDEFINED

# Domínio público da sua landing page. Necessário para retorno pós-pagamento.
PUBLIC_URL=http://localhost:3000
APP_USER_AGENT=meia-peluciada-lp/1.0

# Token que você configura no webhook do Asaas, não é a API key.
ASAAS_WEBHOOK_TOKEN=crie_um_token_forte_com_32_caracteres_ou_mais

# Configuração comercial
PRODUCT_NAME=Meia Calça Peluciada Premium
SUPPORT_WHATSAPP=5547999999999
STOCK_AVAILABLE=17
OFFER_1_PRICE=89.90
OFFER_2_PRICE=149.90
OFFER_3_PRICE=209.90
